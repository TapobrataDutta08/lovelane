# 1. Dependencies (huge folders; these get reinstalled via npm install)
node_modules/
/.pnp
.pnp.js

# 2. Environment Variables & Secrets (CRITICAL: keeps your Supabase keys safe)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 3. Build & Output Folders (created automatically when you build/deploy)
dist/
build/
.next/
out/

# 4. Logs and Debugging Files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. Operating System Junk Files
.DS_Store
Thumbs.db

# 6. IDE / Code Editor Settings
.vscode/
.idea/
*.swp
*.swo